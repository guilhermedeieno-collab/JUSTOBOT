# Application
APP_NAME=JUSTOBOT
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://justobot:password@localhost:5432/justobot
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# Security
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY_HEADER=X-API-Key

# TJSP Configuration
TJSP_BASE_URL=https://esaj.tjsp.jus.br
TJSP_TIMEOUT=30
TJSP_MAX_RETRIES=3
TJSP_RATE_LIMIT=10

# Bulk Processing
BULK_MAX_CONCURRENT_REQUESTS=5
BULK_BATCH_SIZE=100
BULK_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
